@model FestivalPageViewModel;

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<form>
    Search by name : <input type="text" name="searchString" value="@Model.SearchString" />
    <input type="submit" value="Search" class="btn btn-default" />
</form>
<!--Sap xep-->
<p>Sort:
    <a asp-action="Index" asp-route-sortOrder="" asp-route-PageNumber="@Model.CurrentPage" asp-route-searchString="@Model.SearchString">ASC</a> |<a asp-action="Index" asp-route-sortOrder="desc" asp-route-PageNumber="@Model.CurrentPage" asp-route-searchString="@Model.SearchString">DESC</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                Location
            </th>
            <th>
                OrganizerId
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Festivals) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrganizerId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FestivalId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FestivalId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.FestivalId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
<div>
    Trang : @Model.CurrentPage / @Model.TotalPages
     <!--Nut phan trang-->
@if (Model.CurrentPage > 1)
    {
        <a asp-action="Index" asp-route-PageNumber="@(Model.CurrentPage - 1)" asp-route-sortOrder="@Model.SortOrder" asp-route-searchString="@Model.SearchString">Previous</a>
    }
@if (Model.CurrentPage < Model.TotalPages)
    {
        <a asp-action="Index" asp-route-PageNumber="@(Model.CurrentPage + 1)" asp-route-sortOrder="@Model.SortOrder" asp-route-searchString="@Model.SearchString">Next</a>
    }

</div>